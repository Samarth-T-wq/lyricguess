# Backend environment variables.
# Copy to .env for local development: cp .env.example .env
# On Railway, set these in the service's Variables tab instead.

# Port the API listens on.
# Railway injects PORT automatically — do NOT set it there.
PORT=5000

# Allowed browser origin(s) for CORS, comma-separated.
# Leave unset/empty to allow all origins (fine for the MVP).
# Once the frontend is deployed, lock it down, e.g.:
#   CORS_ORIGIN=https://lyricguess.vercel.app
CORS_ORIGIN=
