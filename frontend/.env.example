# Frontend environment variables.
# Copy to .env for local development: cp .env.example .env
# On Vercel, set this in Project Settings -> Environment Variables instead.
#
# Only vars prefixed with VITE_ are exposed to the browser bundle.

# Base URL of the backend API — no trailing slash.
# Local:      http://localhost:5000
# Production: the Railway public URL, e.g. https://lyricguess-api.up.railway.app
VITE_API_URL=http://localhost:5000
